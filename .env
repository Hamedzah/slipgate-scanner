# =============================================================================
# SlipGate Scanner - Environment Configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# --- Telegram API credentials (https://my.telegram.org) ---
TG_API_ID=123456
TG_API_HASH=your_api_hash_here
# Generated once locally via `python scripts/generate_session.py`
TG_SESSION_STRING=

# --- Source channels to scrape ---
# Comma-separated. Public channels: @channel_name
# Private channels: invite links (https://t.me/+xxxxxxxx) — the bot/user
# account must join these; the collector will attempt to join automatically.
SOURCE_CHANNELS=@example_channel_1,@example_channel_2,https://t.me/+AbCdEfGhIjK

# --- Broadcast target ---
TARGET_CHANNEL=@SlipGate_hub
# Tag appended to every outgoing message / used to replace foreign tags
OWN_CHANNEL_TAG=@SlipGate_hub

# --- Scoring ---
SCORE_THRESHOLD=70
# Weights must sum to 1.0 — see docs/SCORING.md for rationale
WEIGHT_LATENCY=0.25
WEIGHT_SPEED=0.25
WEIGHT_STABILITY=0.20
WEIGHT_GEO=0.15
WEIGHT_PROTOCOL=0.15

# --- Testing parameters ---
TEST_CONCURRENCY=25
TEST_ROUNDS=3
TEST_TIMEOUT_SECONDS=10
SPEED_TEST_MIN_BYTES=5242880
SPEED_TEST_URL=https://speed.cloudflare.com/__down?bytes=5242880
IRAN_REFERENCE_LAT=35.6892
IRAN_REFERENCE_LON=51.3890

# --- Database ---
# sqlite+aiosqlite:///./data/slipgate.db  (dev)
# postgresql+asyncpg://user:pass@host:5432/slipgate  (prod)
DATABASE_URL=sqlite+aiosqlite:///./data/slipgate.db

# --- Security ---
# 32-byte urlsafe base64 key, generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- Rate limiting ---
TELEGRAM_MAX_REQUESTS_PER_MINUTE=20
BROADCAST_MAX_CONFIGS_PER_MESSAGE=10

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
ENVIRONMENT=production

# --- Metrics ---
METRICS_ENABLED=true
METRICS_PORT=9090

# --- Optional: GeoIP MaxMind DB path (offline fallback) ---
GEOIP_DB_PATH=./data/GeoLite2-City.mmdb
